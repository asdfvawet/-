T* (            px = candles[i].close) Tj
T* () Tj
T* (            if sig:) Tj
T* (                exec_px = px * \(1 + self.slippage_rate if sig.side == Side.BUY else 1 - self.slippage_rate\)) Tj
T* (                if sig.side == Side.BUY and cash > exec_px:) Tj
T* (                    buy_qty = \(cash * 0.2\) / exec_px) Tj
T* (                    fee = buy_qty * exec_px * self.fee_rate) Tj
T* (                    cash -= buy_qty * exec_px + fee) Tj
T* (                    qty += buy_qty) Tj
T* (                    trades += 1) Tj
T* (                elif sig.side == Side.SELL and qty > 0:) Tj
T* (                    sell_qty = qty * 0.2) Tj
T* (                    fee = sell_qty * exec_px * self.fee_rate) Tj
T* (                    cash += sell_qty * exec_px - fee) Tj
T* (                    qty -= sell_qty) Tj
T* (                    trades += 1) Tj
T* () Tj
T* (            equity_curve.append\(cash + qty * px\)) Tj
T* () Tj
