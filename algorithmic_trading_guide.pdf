T* (        peak = equity_curve[0]) Tj
T* (        mdd = 0.0) Tj
T* (        for e in equity_curve:) Tj
T* (            peak = max\(peak, e\)) Tj
T* (            dd = \(e - peak\) / peak * 100) Tj
T* (            mdd = min\(mdd, dd\)) Tj
T* () Tj
T* (        return BacktestResult\(total_return_pct=total_return, max_drawdown_pct=abs\(mdd\), trades=trades\)) Tj
T* () Tj
