(    def run\(self, symbol: str, asset_class: AssetClass, candles: List[Candle], initial_cash: float = 10_000_000\) -> BacktestResult:) Tj
T* (        cash = initial_cash) Tj
T* (        qty = 0.0) Tj
T* (        equity_curve: List[float] = []) Tj
